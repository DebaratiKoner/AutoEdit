{
  "name": "autoedit",
  "version": "1.1.0",
  "description": "AI-powered video editor with automatic transcription, intelligent clip division, and seamless editing workflows",
  "type": "module",
  "keywords": [
    "video-editor",
    "ai",
    "transcription",
    "react",
    "typescript",
    "remotion",
    "openai",
    "whisper",
    "video-processing"
  ],
  "author": "AutoEdit Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/your-username/autoedit.git"
  },
  "bugs": {
    "url": "https://gitlab.com/your-username/autoedit/-/issues"
  },
  "homepage": "https://gitlab.com/your-username/autoedit#readme",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "clean": "rm -rf dist node_modules/.vite",
    "docker:build": "docker build -t autoedit .",
    "docker:run": "docker-compose up",
    "prepare": "husky install || true"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.448",
    "@remotion/player": "^4.0.448",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.1",
    "remotion": "^4.0.448"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "fast-check": "^3.15.0",
    "husky": "^8.0.3",
    "jsdom": "^23.0.1",
    "prettier": "^3.1.0",
    "typescript": "^5.2.2",
    "vite": "^5.0.8",
    "vitest": "^1.1.0"
  }
}
